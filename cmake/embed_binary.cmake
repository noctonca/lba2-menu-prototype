# Invoked as: cmake -DINPUT=<path> -DOUTPUT=<path> -DSYMBOL=<name> -P embed_binary.cmake
# Emits a C++ source embedding INPUT's bytes as `const unsigned char <SYMBOL>[]`
# plus `const U32 <SYMBOL>Size`. Generic byte embedder (fonts, etc.); the older
# cmake/embed_lba2_cfg.cmake is the cfg-specific sibling.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "embed_binary.cmake requires -DINPUT= -DOUTPUT= -DSYMBOL=")
endif()

file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _hexlen)
math(EXPR _nbytes "${_hexlen} / 2")

set(_lines "// Generated by cmake/embed_binary.cmake - do not edit\n")
string(APPEND _lines "#include <SYSTEM/ADELINE_TYPES.H>\n\n")
string(APPEND _lines "extern \"C\" const unsigned char ${SYMBOL}[] = {\n")

if(_nbytes EQUAL 0)
    string(APPEND _lines "\n")
else()
    math(EXPR _last "${_nbytes} - 1")
    set(_row "")
    set(_col 0)
    foreach(_i RANGE 0 ${_last})
        math(EXPR _off "${_i} * 2")
        string(SUBSTRING "${_hex}" ${_off} 2 _byte)
        if(_col GREATER 0)
            string(APPEND _row ", ")
        endif()
        string(APPEND _row "0x${_byte}")
        math(EXPR _col "${_col} + 1")
        if(_col EQUAL 16)
            string(APPEND _lines "    ${_row},\n")
            set(_row "")
            set(_col 0)
        endif()
    endforeach()
    if(_col GREATER 0)
        string(APPEND _lines "    ${_row},\n")
    endif()
endif()

string(APPEND _lines "};\n\n")
string(APPEND _lines "extern \"C\" const U32 ${SYMBOL}Size = (U32)sizeof(${SYMBOL});\n")

file(WRITE "${OUTPUT}" "${_lines}")
